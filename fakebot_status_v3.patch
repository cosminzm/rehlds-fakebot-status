 SV_SAVEGAMECOMMENT_FUNC g_pSaveGameCommentFunc = &Host_SavegameComment;
 
+// Cache a random Steam2-formatted ID for each fake client slot so the
+// value stays stable during a connection but changes when the slot gets
+// a new userid. These IDs are for status display only.
+static client_t *g_FakeBotStatusClients[MAX_CLIENTS] = {};
+static int g_FakeBotStatusUserids[MAX_CLIENTS] = {};
+static char g_FakeBotStatusIds[MAX_CLIENTS][32] = {};
+
+static const char *Host_GetFakeBotStatusId(client_t *client)
+{
+	int slot = (int)(client - g_psvs.clients);
+	if (slot < 0 || slot >= MAX_CLIENTS)
+		return "STEAM_0:0:1";
+
+	if (g_FakeBotStatusClients[slot] != client || g_FakeBotStatusUserids[slot] != client->userid)
+	{
+		unsigned int authServer = (unsigned int)RandomLong(0, 1);
+		unsigned int accountId;
+
+		do
+		{
+			accountId = (unsigned int)RandomLong(100000000, 0x7FFFFFFE);
+		} while (accountId == 0);
+
+		Q_snprintf(g_FakeBotStatusIds[slot], sizeof(g_FakeBotStatusIds[slot]),
+			"STEAM_0:%u:%u", authServer, accountId);
+
+		g_FakeBotStatusClients[slot] = client;
+		g_FakeBotStatusUserids[slot] = client->userid;
+	}
+
+	return g_FakeBotStatusIds[slot];
+}
+
